# Base de datos PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/brayton?schema=public"

# JWT (cambiar en producción)
JWT_SECRET=change-me-in-production-min-32-chars
JWT_REFRESH_SECRET=refresh-change-me-in-production

# API
PORT=4000
FRONTEND_URL=http://localhost:3000

# Next.js (frontend)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=https://braytonsrl.com.ar

# Opcional: carpeta de uploads (por defecto ./uploads)
# UPLOADS_DIR=/var/app/uploads
